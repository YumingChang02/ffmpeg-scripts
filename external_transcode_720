#!/bin/bash
EXPECTED_ARGS=2
ARGC=$#

if [ $ARGC -lt $EXPECTED_ARGS ]; then
    echo "Usage: $0 <input_file> <quality> [output_path]"
    exit 1
fi

INPUT_FILE="${1}"
QUALITY="${2}"
OUTPUT_PATH="${3:-$(pwd)}"

IGPU_DEV="/dev/dri/renderD128"
DGPU_DEV="/dev/dri/renderD128"

random_suffix=$(echo $RANDOM | md5sum | head -c 20)
file_name=$(basename "$INPUT_FILE")
FORMAT=$(mediainfo --Inform="Video;%Format%" "$INPUT_FILE")

echo "========================================================="
echo "Transcoding : $INPUT_FILE"
echo "Format      : $FORMAT"
echo "Quality     : $QUALITY"
echo "Output Path : $OUTPUT_PATH"
echo "========================================================="

# --- 1. HEVC Check ---
if [[ "$FORMAT" =~ "HEVC" ]]; then
    echo "File : $INPUT_FILE is already in HEVC format, skipping..."
    mv "$INPUT_FILE" "$OUTPUT_PATH/$file_name"
    exit 0
fi

# --- 2. Resolution & Resize Logic ---
# Save the original IFS
OLD_IFS="$IFS"

# Change it just to parse ffprobe
IFS=$'\n'
arr=($(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of default=nw=1:nk=1 "$INPUT_FILE"))

# Restore the original IFS immediately!
IFS="$OLD_IFS"

WIDTH=${arr[0]}
HEIGHT=${arr[1]}
RESIZE=false

if [[ "$WIDTH" -gt 1280 && "$HEIGHT" -gt 720 ]]; then
    echo "Resolution: $WIDTH x $HEIGHT -> Setting resize parameter (Max 720p)"
    RESIZE=true
else
    echo "Resolution: $WIDTH x $HEIGHT -> No scaling required"
fi

TEMP_FILE="/tmp/temp_${random_suffix}.mp4"

# Pre-define filters based on the RESIZE variable to keep FFmpeg commands clean
if [ "$RESIZE" = true ]; then
    VF_FULL_HW="hwmap=derive_device=qsv,format=qsv,scale_qsv=w=1280:h=-1:mode=hq"
    VF_SW_HW="scale='min(1280,iw)':-1,hwupload=extra_hw_frames=64,format=qsv"
    HB_RESIZE="--width 1280"
else
    VF_FULL_HW="hwmap=derive_device=qsv,format=qsv"
    VF_SW_HW="hwupload=extra_hw_frames=64,format=qsv"
    HB_RESIZE=""
fi

transcode_success=false

# --- ATTEMPT 1: FFmpeg Full Hardware (VAAPI Decode -> QSV Encode) ---
echo ">>> Attempt 1: FFmpeg Full Hardware Transcode"
ffmpeg -y -xerror -loglevel error -stats \
    -init_hw_device vaapi=va:$DGPU_DEV -init_hw_device qsv=qs@va -filter_hw_device qs -extra_hw_frames 64 \
    -hwaccel vaapi -hwaccel_output_format vaapi \
    -i "$INPUT_FILE" -vf "$VF_FULL_HW" \
    -c:v hevc_qsv -look_ahead 1 -look_ahead_depth 40 -global_quality "$QUALITY" \
    "$TEMP_FILE"

if [ $? -eq 0 ]; then
    transcode_success=true
else
    echo ">>> Attempt 1 Failed. Falling back to Attempt 2..."
    rm -f "$TEMP_FILE"

    # --- ATTEMPT 2: FFmpeg Software Decode -> Hardware Encode (QSV) ---
    # echo ">>> Attempt 2: FFmpeg Software Decode + HW Encode"
    # ffmpeg -y -xerror -loglevel error -stats \
    #     -init_hw_device qsv=hw,child_device=$IGPU_DEV -filter_hw_device hw \
    #     -i "$INPUT_FILE" -vf "$VF_SW_HW" \
    #     -c:v hevc_qsv -look_ahead 1 -look_ahead_depth 40 -global_quality "$QUALITY" \
    #     "$TEMP_FILE"

    # if [ $? -eq 0 ]; then
    #     transcode_success=true
    # else
    # echo ">>> Attempt 2 Failed. Falling back to Attempt 3..."
    # rm -f "$TEMP_FILE"

    # --- ATTEMPT 3: HandBrakeCLI (QSV Hardware Encode) ---
    echo ">>> Attempt 2: HandBrakeCLI (Hardware QSV)"
    # Note: HandBrake auto-handles SW decode -> HW encode gracefully
    HandBrakeCLI -i "$INPUT_FILE" -o "$TEMP_FILE" -e qsv_h265 -q "$QUALITY" $HB_RESIZE -x "lookahead=1:lookahead_depth=40"

    if [ $? -eq 0 ]; then
        transcode_success=true
    else
        echo ">>> Attempt 2 Failed."
    fi
    # fi
fi

# --- Post-Processing & Validation ---
if [ "$transcode_success" = true ]; then
    ORIGINAL_SIZE=$(stat -c%s "$INPUT_FILE")
    NEW_SIZE=$(stat -c%s "$TEMP_FILE")

    # If the HW transcoded file is larger than the original, run CPU fallback
    if [[ $NEW_SIZE -ge $ORIGINAL_SIZE ]]; then
        echo ">>> Warning: Transcoded file is larger than original. Running HandBrake CPU x265 fallback..."
        rm -f "$TEMP_FILE"

        # Using your original file locking for CPU resources
        flock -x /tmp/.cpu-transcode.lock HandBrakeCLI -i "$INPUT_FILE" -o "$TEMP_FILE" -e x265 -q "$QUALITY" $HB_RESIZE

        if [ $? -ne 0 ]; then
            echo ">>> CPU Transcode Failed."
            echo "$INPUT_FILE" >> /home/markchang/failed.log
            rm -v -f "$TEMP_FILE" "$INPUT_FILE"
            exit 0
        fi
    fi

    # Final Success Actions
    echo "$INPUT_FILE" >> /home/markchang/storage/.success.log
    du -sh "$INPUT_FILE" && du -sh "$TEMP_FILE"
    rm -f "$INPUT_FILE"
    mv -v "$TEMP_FILE" "$OUTPUT_PATH/${file_name%.*}.mp4"
    exit 0

else
    # All hardware and software transcode attempts failed
    echo ">>> Error: All transcode attempts failed."
    echo "$INPUT_FILE" >> /home/markchang/failed.log
    rm -v -f "$TEMP_FILE" "$INPUT_FILE"
    exit 0
fi
